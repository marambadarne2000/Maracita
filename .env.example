# Copy to .dev.vars or run: node scripts/init-local-env.mjs
# Never commit actual credentials. Local registration uses the application DB.
INTEGRATIONS_ENCRYPTION_KEY=
JOB_SECRET=
BACKUP_ENCRYPTION_KEY=
PUBLIC_BASE_URL=http://localhost:3000
SUPPORT_EMAIL=maram.software.tech@gmail.com
ENVIRONMENT=development
ALLOW_DEMO=1
# Optional local account ID for operator access (after registering):
# LAUNCH_ADMIN_ACCOUNT_ID=
# Optional system Resend sender; Gmail is configured in Launch Center:
# RESEND_API_KEY=
# EMAIL_FROM=
# Supabase is optional legacy configuration, not required for local sign-in:
# SUPABASE_URL=
# SUPABASE_PUBLISHABLE_KEY=
